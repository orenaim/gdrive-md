# ---------------------------------------------------------------------------
# Headwall MD — public configuration
#
# Everything here is PUBLIC. It is compiled into the browser bundle by Vite and
# is visible to anyone who opens the app. There is deliberately no client
# secret: the app uses the browser OAuth token flow and has no backend that
# could hold one. Never add a secret to this file or to any VITE_* variable.
#
# Copy to `.env.local` for local development.
# ---------------------------------------------------------------------------

# OAuth 2.0 Client ID (type: Web application) from the Google Cloud console.
# A client ID is an identifier, not a credential — it is safe in the bundle.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Restricts sign-in to one Google Workspace domain. Sent to Google as the `hd`
# parameter and re-checked against the signed-in account after the fact.
# Leave blank to allow any account.
VITE_WORKSPACE_DOMAIN=headwall.ai

# ---------------------------------------------------------------------------
# Timing. The defaults are the ones the product was designed around; they are
# exposed mainly so they can be shortened in tests or lengthened if Drive quota
# ever becomes a concern.
# ---------------------------------------------------------------------------

# Quiet typing before a save is attempted.
VITE_AUTOSAVE_DEBOUNCE_MS=2000

# Longest a continuous typing run may go unsaved.
VITE_AUTOSAVE_MAX_INTERVAL_MS=5000

# Revision poll interval while the tab is visible.
VITE_POLL_ACTIVE_MS=3000

# Revision poll interval while the tab is hidden.
VITE_POLL_HIDDEN_MS=60000
